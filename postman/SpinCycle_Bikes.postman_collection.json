                  "  const data = pm.response.json();",
                  "  const prevNum = parseInt(pm.collectionVariables.get('bike1Code').replace('BKE-', ''), 10);",
                  "  const currNum = parseInt(data.bike_code.replace('BKE-', ''), 10);",
                  "  pm.expect(currNum).to.eql(prevNum + 1);",
                  "  if (data.id === 2) {",
                  "    pm.expect(data.bike_code).to.eql('BKE-0002');",
                  "  }",
                  "  pm.collectionVariables.set('bike2Id', String(data.id));",
