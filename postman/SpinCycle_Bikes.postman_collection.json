          "name": "POST Create Bike 1 (Auto Code BKE-0001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Generates sequential bike_code (BKE-0001 for first bike)', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.bike_code).to.match(/^BKE-\\d{4,}$/);",
                  "  if (data.id === 1) {",
                  "    pm.expect(data.bike_code).to.eql('BKE-0001');",
                  "  }",
                  "  pm.expect(data.status).to.eql('available');",
                  "  pm.collectionVariables.set('bike1Id', String(data.id));",
                  "  pm.collectionVariables.set('bike1Code', data.bike_code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
