                  "});",
                  "pm.test('Returns joined rider_name and bike_name for the created rental', function () {",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows).to.be.an('array').that.is.not.empty;",
                  "  const targetId = Number(pm.collectionVariables.get('rentalId'));",
                  "  const rental = rows.find(function (r) { return r.id === targetId; });",
                  "  pm.expect(rental, 'Created rental should appear in /rentals/details').to.be.an('object');",
                  "  pm.expect(rental.rider_name).to.eql('Alice Morgan');",
                  "  pm.expect(rental.bike_name).to.eql('Summit X1 Pro');",
                  "  pm.expect(rental.bike_code).to.eql(pm.collectionVariables.get('bike1Code'));",
                  "  pm.expect(rental.bike_status).to.eql('rented');",
                  "});"
